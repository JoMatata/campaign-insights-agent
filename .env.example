# Needed for `make ask`, `make eval` and the LLM classifier. Leave empty to use the scripted demo.
ANTHROPIC_API_KEY=
# Optional: model override
# CIA_ANTHROPIC_MODEL=claude-sonnet-4-5
# Optional: only for --provider openai
# OPENAI_API_KEY=
# auto (sentence-transformers, falling back to TF-IDF), st, or tfidf
CIA_EMBEDDER=auto
